# Copy to .env.local and fill in. Never commit .env.local, and never put a real key in this file.
# Get a key at https://dashboard.sarvam.ai — one key covers the LLM, text-to-speech and speech-to-text.
SARVAM_API_KEY=
# Optional
SARVAM_MODEL=sarvam-105b
# Reasoning before answering: none | low | medium | high | max | off (off disables it entirely)
SARVAM_REASONING_EFFORT=off
SARVAM_TIMEOUT_MS=90000
ANALYZE_RATE_LIMIT=8

# Voice for the practice buyer (optional). Browser speech is always the fallback.
# TTS_PROVIDER=sarvam | elevenlabs | fish | none   (default: sarvam when SARVAM_API_KEY is set)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# SARVAM_TTS_PACE=1.0
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_VOICE_ID=
# FISH_AUDIO_MODEL=

# Voice answers from the salesperson (optional). Browser speech recognition is the fallback.
# STT_PROVIDER=sarvam | none   (default: sarvam when SARVAM_API_KEY is set)
SARVAM_STT_MODEL=saaras:v4

# Testing only: point Sarvam calls at the local stub (npm run stub:sarvam). Leave unset in production.
# SARVAM_API_BASE=http://localhost:4010
